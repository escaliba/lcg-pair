{
  "name": "lcg-pair",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/pair.ts",
    "build:win": "bun build src/pair.ts --compile --target=bun-windows-x64 --outfile dist/lcg-pair-windows.exe",
    "build:mac-arm": "bun build src/pair.ts --compile --target=bun-darwin-arm64 --outfile dist/lcg-pair-darwin-arm64",
    "build:mac-x64": "bun build src/pair.ts --compile --target=bun-darwin-x64 --outfile dist/lcg-pair-darwin-x64",
    "build:linux": "bun build src/pair.ts --compile --target=bun-linux-x64 --outfile dist/lcg-pair-linux",
    "build:all": "rm -rf dist && bun run build:win && bun run build:mac-arm && bun run build:mac-x64 && bun run build:linux",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chrome-launcher": "^1.1.2",
    "long": "^5.2.4",
    "protobufjs": "^7.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "5.9.3"
  }
}
